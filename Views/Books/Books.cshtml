@model List<MVCMoment.Models.Book>

@{
    ViewData["Titel"] = "Böcker";
}

<div class="content" onload="markedBooks()">
    <h1>@ViewData["Titel"]</h1>


     @if (ViewBag.Message != null)
    {
        <div class="popup">
            @ViewBag.Message
        </div>
    }

<div>
   

    @if (Model == null || !Model.Any())
        {
            <p>Inga böcker i listan.</p>
        }
        else{
            <ul class="allBooks">
        @foreach (var book in Model)
        {
            <li id="@book.Id">
                <p><b>@book.Title</b></p>
                <p>@book.Author</p>
                <div class="flexButtons">
            <form method="post" action="@Url.Action("AddRead", "Books")">
                <input type="hidden" name="Title" value="@book.Title"/>
                <input type="hidden" name="Author" value="@book.Author"/>
                <button class="buttonSubmit" type="submit" >Färdig</button>
                  
                </form>
               <button class="buttonActive" onclick="activeRead('@book.Id')">Markera</button> 
               </div>          
            </li>
        }
        </ul>
        }
    
</div>
</div>