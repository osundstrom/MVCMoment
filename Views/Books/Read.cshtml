@model List<MVCMoment.Models.Book>

@{
    ViewData["Titel"] = "Lästa";
}

<div class="content">
    <h1>Lästa</h1>

<div class="readDiv">
    


    @if (Model == null || !Model.Any()){
            <p>Inga lästa böcker.</p>
        }
        
        else{
            <ul>
    @foreach (var book in Model){
        <li>
            @book.Title av @book.Author
        </li>
    }
    </ul>
    }

</div>
</div>